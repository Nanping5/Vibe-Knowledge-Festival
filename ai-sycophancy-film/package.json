{
  "name": "ai-sycophancy-film",
  "version": "1.0.0",
  "description": "A 120-second silent text-led editorial motion-graphics documentary about AI sycophancy.",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/validate-timeline.ts",
    "preview": "remotion render src/index.ts MainFilm output/preview.mp4 --scale 0.5 --codec h264 --crf 27",
    "qc:frames": "tsx scripts/extract-frames.ts",
    "render": "tsx scripts/render-final.ts",
    "render:clean": "remotion render src/index.ts MainFilmClean output/final-clean.mp4 --codec h264 --crf 18",
    "captions": "tsx scripts/export-subtitles.ts",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src"
  }
}
